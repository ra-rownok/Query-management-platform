# ==============================================================================
# Query Management Platform - Environment Configuration (PostgreSQL)
# ==============================================================================

# Application Database Engine Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (Default PostgreSQL port: 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform_db

# Option B: Individual PostgreSQL Parameters
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=platform_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_secret_password
# POSTGRES_SCHEMA=public

# Flask Secret Key
# ------------------------------------------------------------------------------
SECRET_KEY=multi-db-quant-dba-secret-key-2026-xyz
